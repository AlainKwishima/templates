NODE_ENV=development
PORT=4001
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=Auth Service
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/auth_db?schema=public
USER_SERVICE_URL=http://localhost:4002
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
JWT_ACCESS_SECRET=replace-with-a-strong-32-byte-secret-minimum
JWT_REFRESH_SECRET=replace-with-another-strong-32-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=enterprise-backend
JWT_AUDIENCE=enterprise-backend-clients
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=National_Examination
