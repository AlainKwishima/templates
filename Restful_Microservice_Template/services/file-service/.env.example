NODE_ENV=development
PORT=4003
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=File Service
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/file_db?schema=public
JWT_ACCESS_SECRET=replace-with-a-strong-32-byte-secret-minimum
JWT_REFRESH_SECRET=replace-with-another-strong-32-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=enterprise-backend
JWT_AUDIENCE=enterprise-backend-clients
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
