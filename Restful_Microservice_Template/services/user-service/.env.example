NODE_ENV=development
PORT=4002
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=User Service
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/user_db?schema=public
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
JWT_ACCESS_SECRET=replace-with-a-strong-32-byte-secret-minimum
