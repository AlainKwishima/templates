JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=enterprise-backend
JWT_AUDIENCE=enterprise-backend-clients
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
